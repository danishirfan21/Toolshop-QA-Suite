{
  "name": "toolshop-qa-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript QA suite for the Practice Software Testing (Toolshop) app",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:desktop": "playwright test --project=chromium-desktop",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:api": "playwright test --project=api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-plugin-playwright": "2.12.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
